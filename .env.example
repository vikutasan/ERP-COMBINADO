# ═══════════════════════════════════════════════════════════════════════════════
# ERP COMBINADO — variables de entorno de referencia
# ═══════════════════════════════════════════════════════════════════════════════
# Copiar a `.env` y ajustar. El archivo `.env` real NUNCA se commitea.
#
# IMPORTANTE: las credenciales de PRODUCCIÓN (ERP-R-DE-RICO) no viven aquí.
# La importación de la FASE 2 usa un rol de SOLO LECTURA creado aparte
# (`erp_combinado_lectura`) y se ejecuta con variables propias del script.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── POS — Punto de Venta IA (frontend 5210, API 5211) ───────────────────────
POS_FRONTEND_PORT=5210
POS_API_PORT=5211
POS_DB_PORT=5440
POS_DB_NAME=erp_pos
POS_DB_USER=pos
POS_DB_PASSWORD=cambiar_esta_clave
POS_API_BASE_URL=http://localhost:5211

# ─── PostgreSQL compartido del ERP COMBINADO ─────────────────────────────────
# Un contenedor por módulo, todos en el rango 5440–5450.
POSTGRES_HOST=localhost
POSTGRES_USER=pos
POSTGRES_PASSWORD=cambiar_esta_clave

# ─── Orígenes permitidos por CORS ────────────────────────────────────────────
# El shell del hub (5200) y el propio POS (5210).
CORS_ORIGINS=http://localhost:5200,http://localhost:5210

# ─── Zona horaria (RT-01: se almacena en UTC, se muestra local) ──────────────
TZ=America/Mexico_City

# ─── Importación desde producción (FASE 2) — SOLO LECTURA ────────────────────
# Rol con permisos exclusivamente SELECT sobre products, categories,
# employees y security_profiles. Nunca usar el usuario de la aplicación.
PROD_DB_HOST=localhost
PROD_DB_PORT=5433
PROD_DB_NAME=erp_rderico
PROD_DB_USER=erp_combinado_lectura
PROD_DB_PASSWORD=cambiar_esta_clave
