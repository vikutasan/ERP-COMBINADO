# Variables de entorno del POS nuevo — FP-01.
#
# Copia este archivo a `.env` y ajusta los valores para tu entorno.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# Uso:
#   cp .env.example .env
#   # Editar .env con los valores reales
#   npm run dev

# URL base del API del POS nuevo.
# En desarrollo apunta al contenedor Docker local.
# En producción apunta al servidor real.
#
# Ejemplos:
#   Desarrollo local:   VITE_API_URL=http://localhost:5101
#   Producción:         VITE_API_URL=https://api.rdeRico.com
#   Staging:            VITE_API_URL=https://staging-api.rdeRico.com
VITE_API_URL=http://localhost:5101
